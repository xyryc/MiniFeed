# API endpoint URL for RTK Query. 
# In Expo, variables prefixed with EXPO_PUBLIC_ are exposed to the client.
# Replace with your ngrok URL or your local machine's local IP address (e.g. http://192.168.1.50:3001/api) so that emulators and real devices can connect.
EXPO_PUBLIC_API_URL=http://<YOUR_LOCAL_IP>:3001/api
